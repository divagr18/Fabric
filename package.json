{
  "name": "fabric",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  }
}
